  "prompt": {
    "brief": "brief.md",
    "forbidden_patterns": [
      {
        "pattern": "Rules that must be held in memory rather than shown on screen",
        "why": "Confounds attention with working memory."
      },
      {
        "pattern": "More than one rule change inside a block",
        "why": "Becomes a task-switching (executive) measure."
      },
      {
        "pattern": "Stimuli distinguished by colour alone",
        "why": "Fails colour-vision accessibility; no accessible substitute can replicate it."
      },
      {
        "pattern": "Target that differs from distractors on more than one feature at high difficulty",
        "why": "Produces pop-out, collapsing the search slope."
      },
      {
        "pattern": "Semantically loaded stimuli (words, faces, emotional content)",
        "why": "Introduces language and affect as uncontrolled variables."
      },
      {
        "pattern": "Instructions longer than 40 words",
        "why": "Instruction comprehension becomes the measured variable."
      },
      {
        "pattern": "A no-deadline setting above theta 0.5",
        "why": "Leaves the speed-accuracy trade-off uncontrolled."
      }
    ],
    "referent_classes": [
      "digits",
      "geometric_shapes",
      "arrows",
      "letter_codes"
    ],
    "thinking": "low",
    "reading_level": "grade_4"
  },
  "context_blind_tolerance_pp": 8,
  "scoring": {
    "primary": "residualised_error_rate",
    "derived": [
      "rt_cv",
      "vigilance_slope",
      "congruency_cost",
      "search_slope",
      "omissions",
      "anticipations"
    ],
    "sato_control": true,
    "report_label": "Attention",
    "report_blurb": "How well focus was kept on the task and distraction was resisted.",
    "report_caveat": "Attention scores are differences between conditions or speed-controlled residuals; single-session reliability of difference scores is modest.",
    "report_components": [
      "sustained",
      "selective"
    ]
  },
  "requires_services": [
    "timing_harness",
    "trial_sequencer"
  ],
  "bank": {
    "k_min_per_cell": 12,
    "k_fresh_per_cell": 4,
    "b_band_width": 0.5,
    "batch_size": 6,
    "locales": [
      "en",
      "en-IN"
    ]
  }
}

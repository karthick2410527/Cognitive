{
  "plugin_id": "executive",
  "name": "Executive Function",
  "version": "1.0.0",
  "engine_range": ">=2.0.0 <3.0.0",
  "status": "beta",
  "auto_promote": true,
  "construct": {
    "definition": "The control processes that select, maintain and change task goals: inhibiting habitual responses, shifting between rules, updating working-memory contents, inducing unstated rules, and planning sequences of actions.",
    "exclusions": [
      "General intelligence: shifting is scored as a switch cost, never a raw error count.",
      "Processing speed: sequencing is scored as B minus A, never B alone.",
      "Attention: flanker and sustained-vigilance tasks belong to the attention plugin.",
      "Reading and vocabulary: literacy-free interference variants are the default.",
      "Memory: n-back declares its memory loading explicitly."
    ],
    "clinical_anchors": [
      "Stroop Color and Word Test (literacy-free spatial and size analogues)",
      "n-back",
      "Raven's Progressive Matrices (figural reasoning)",
      "Wisconsin Card Sorting Test",
      "Tower of London"
    ],
    "references": [
      "research.md#references"
    ]
  },
  "dimensions": [
    "executive",
    "memory"
  ],
  "loading": {
    "executive": 1.0
  },
  "task_type_loadings": {
    "n_back_block": {
      "executive": 0.7,
      "memory": 0.3
    }
  },
  "prior": {
    "a": 1.2,
    "b_range": [
      -3,
      3
    ]
  },
  "lever_model": "calibration/lever-model.json",
  "min_items_for_theta": 2,
  "target_se": 0.32,
  "task_types": [
    {
      "id": "matrix_completion",
      "one_line": "A 3 by 3 grid of figures governed by unstated rules, with one cell missing; choose the figure that completes it.",
      "protocol": "single",
      "renderer": {
        "target": "svg",
        "module": "renderers/matrix.v1"
      },
      "author": "author/matrix.v1",
      "solver": "solvers/rule.v1",
      "context_blind_solver": "solvers/contextBlind.v1",
      "scoring": "scoring/choice.v1",
      "validators": [
        "validators/forbiddenPatterns.v1"
      ],
      "response_mode": "choice",
      "levers": [
        "rule_count",
        "relation_arity_max",
        "element_count",
        "perceptual_organisation",
        "distracting_attributes",
        "option_count",
        "distractor_distance",
        "analogical_direction",
        "time_limit_ms"
      ],
      "accessibility": {
        "vision_required": true,
        "speech_required": false,
        "hearing_required": false,
        "literacy_required": false,
        "motor_demand": "low",
        "modality": "visual",
        "colour_dependent": false
      },
      "accessible_substitute": null,
      "component": "reasoning",
      "distractor_policy": "fair_tree",
      "default_time_limit_ms": {
        "single": 35000
      },
      "weight": 0.24,
      "modalities": [
        "visual"
      ],
      "normalizer": "normalizers/matrix.v1"
    },
    {
      "id": "interference_block",
      "one_line": "Literacy-free Stroop analogue: respond to an arrow's direction regardless of its side, or to the numerically larger digit regardless of print size.",
      "protocol": "timed_block",
      "renderer": {
        "target": "svg",
        "module": null
      },
      "author": "author/interference.v1",
      "solver": "solvers/block.v1",
      "context_blind_solver": null,
      "scoring": "scoring/interference.v1",
      "expander": "expanders/interference.v1",
      "validators": [
        "validators/forbiddenPatterns.v1"
      ],
      "response_mode": "timed_block",
      "levers": [
        "congruency_ratio",
        "isi_ms",
        "isi_jitter",
        "response_deadline_ms",
        "trials",
        "practice_trials"
      ],
      "accessibility": {
        "vision_required": true,
        "speech_required": false,
        "hearing_required": false,
        "literacy_required": false,
        "motor_demand": "medium",
        "modality": "visual",
        "colour_dependent": false
      },
      "accessible_substitute": null,
      "component": "inhibition",
      "block_norm": {
        "metric": "interference_cost_ms",
        "mu": 45,
        "sigma": 30,
        "direction": "lower_is_better",
        "difference_score": true,
        "provisional": true
      },
      "weight": 0.08,
      "modalities": [
        "visual"
      ],
      "modality_from": null,
      "modality_notes": {
        "visual": "Use the spatial-Stroop analogue with arrows: trial_rule.kind = \"spatial_stroop\". Alternatively: Use the size-Stroop analogue with digits: trial_rule.kind = \"size_stroop\"."
      }
    },
    {
      "id": "n_back_block",
      "one_line": "Shapes appear one at a time; respond when the current shape matches the one n positions back.",
      "protocol": "timed_block",
      "renderer": {
        "target": "svg",
        "module": null
      },
      "author": "author/nback.v1",
      "solver": "solvers/block.v1",
      "context_blind_solver": null,
      "scoring": "scoring/nback.v1",
      "expander": "expanders/nback.v1",
      "validators": [
        "validators/forbiddenPatterns.v1"
      ],
      "response_mode": "timed_block",
      "levers": [
        "n",
        "lure_rate",
        "isi_ms",
        "stimulus_duration_ms",
        "trials",
        "practice_trials"
      ],
      "accessibility": {
        "vision_required": true,
        "speech_required": false,
        "hearing_required": false,
        "literacy_required": false,
        "motor_demand": "low",
        "modality": "visual",
        "colour_dependent": false
      },
      "accessible_substitute": null,
      "component": "updating",
      "block_norm": {
        "metric": "d_prime",
        "mu": 2.2,
        "sigma": 0.9,
        "direction": "higher_is_better",
        "difference_score": false,
        "provisional": true
      },
      "weight": 0.12,
      "modalities": [
        "visual"
      ],
      "modality_from": null,
      "modality_notes": {
        "visual": "Use shapes or abstract symbols: trial_rule.stimulus_set = {\"type\": \"shapes\", \"values\": [6 of circle, square, triangle, diamond, pentagon, hexagon, star, cross]} or {\"type\": \"symbols\", \"set\": \"high\", \"values\": [6 distinct ids 0-8]}. No other types (no arrows, letters or colours). Alternatively: Use digits: trial_rule.stimulus_set = {\"type\": \"digits\", \"values\": [6 distinct digits from 1-9]}."
      }
    },
    {
      "id": "number_series",
      "one_line": "A row of whole numbers follows one hidden rule; choose the number that comes next.",
      "levers": [
        "series_rule",
        "terms_shown",
        "option_count",
        "time_limit_ms"
      ],
      "weight": 0.2,
      "modality_notes": {
        "text": "stem: the terms_shown numbers separated by \", \" and ending \", ?\" (e.g. \"3, 7, 11, 15, ?\"). instruction_text: \"What number comes next?\". Exactly one positional rule family must fit (series_rule); options are whole numbers, one is the next term. Never state the rule on screen."
      },
      "protocol": "single",
      "renderer": {
        "target": "dom",
        "module": "renderers/textChoice.v1"
      },
      "author": "author/series.v1",
      "solver": "solvers/series.v1",
      "context_blind_solver": null,
      "scoring": "scoring/choice.v1",
      "validators": [
        "validators/textItem.v1"
      ],
      "response_mode": "choice",
      "accessibility": {
        "vision_required": true,
        "speech_required": false,
        "hearing_required": false,
        "literacy_required": false,
        "motor_demand": "low",
        "modality": "visual",
        "colour_dependent": false
      },
      "accessible_substitute": null,
      "component": "reasoning",
      "modalities": [
        "text"
      ],
      "default_time_limit_ms": {
        "single": 45000
      }
    },
    {
      "id": "odd_number_out",
      "one_line": "A row of whole numbers follows one hidden rule except for one number; choose the number that does not fit.",
      "levers": [
        "series_rule",
        "terms_shown",
        "time_limit_ms"
      ],
      "weight": 0.16,
      "modality_notes": {
        "text": "stem: terms_shown numbers separated by \", \" (no question mark). instruction_text: \"One number does not follow the pattern. Which one?\". options: the same numbers as strings, in the same order. Change exactly one term (not the first) by 1–3 so that only it breaks the series_rule. Never state the rule on screen."
      },
      "protocol": "single",
      "renderer": {
        "target": "dom",
        "module": "renderers/textChoice.v1"
      },
      "author": "author/series.v1",
      "solver": "solvers/series.v1",
      "context_blind_solver": null,
      "scoring": "scoring/choice.v1",
      "validators": [
        "validators/textItem.v1"
      ],
      "response_mode": "choice",
      "accessibility": {
        "vision_required": true,
        "speech_required": false,
        "hearing_required": false,
        "literacy_required": false,
        "motor_demand": "low",
        "modality": "visual",
        "colour_dependent": false
      },
      "accessible_substitute": null,
      "component": "reasoning",
      "modalities": [
        "text"
      ],
      "default_time_limit_ms": {
        "single": 45000
      }
    },
    {
      "id": "executive_written",
      "one_line": "A written multiple-choice question whose format the item writer chooses for this domain.",

  "difficulty_levers": {
    "rule_count": {
      "type": "ordinal",
      "values": [
        1,
        2,
        3,
        4
      ],
      "meaning": "Number of rule relations in the puzzle; the dominant driver of figural difficulty.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#rule-count"
    },
    "relation_arity_max": {
      "type": "enum",
      "values": [
        "unary",
        "binary"
      ],
      "meaning": "Highest relation arity allowed (ternary superimposition is not implemented by this renderer version).",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#arity"
    },
    "element_count": {
      "type": "ordinal",
      "values": [
        1,
        2,
        3
      ],
      "meaning": "Maximum figures per cell.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#rule-count"
    },
    "perceptual_organisation": {
      "type": "enum",
      "values": [
        "separation"
      ],
      "meaning": "Elements side by side. Integration and embedding are not implemented by renderer svg-2.0.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#organisation"
    },
    "distracting_attributes": {
      "type": "ordinal",
      "values": [
        0,
        1,
        2
      ],
      "meaning": "Attributes that vary without carrying a rule (capped at 2; with the five-attribute alphabet of svg-2.0, rule_count + distracting_attributes ≤ 5).",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#distracting"
    },
    "option_count": {
      "type": "ordinal",
      "values": [
        4,
        5,
        6,
        7,
        8
      ],
      "meaning": "Number of answer options; lowers the guess rate.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#distractors"
    },
    "distractor_distance": {
      "type": "enum",
      "values": [
        "far",
        "near",
        "minimal"
      ],
      "meaning": "How many attribute changes generate each distractor in the fair tree (far = 2, near/minimal = 1).",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#distractors"
    },
    "analogical_direction": {
      "type": "enum",
      "values": [
        "row",
        "column",
        "both"
      ],
      "meaning": "Axis along which the rules run.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#rule-count"
    },
    "time_limit_ms": {
      "type": "continuous",
      "range": [
        15000,
        60000
      ],
      "meaning": "Time allowed for the item.",
      "direction": "down_is_harder",
      "monotonic": true,
      "research": "research.md#time"
    },
    "congruency_ratio": {
      "type": "continuous",
      "range": [
        0.4,
        0.8
      ],
      "meaning": "Proportion of congruent interference trials.",
      "direction": "down_is_harder",
      "monotonic": true,
      "research": "research.md#interference"
    },
    "isi_ms": {
      "type": "continuous",
      "range": [
        800,
        2600
      ],
      "meaning": "Interval between trials.",
      "direction": "down_is_harder",
      "monotonic": true,
      "research": "research.md#interference"
    },
    "isi_jitter": {
      "type": "continuous",
      "range": [
        0,
        0.4
      ],
      "meaning": "Uniform ± jitter on the interval.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#interference"
    },
    "response_deadline_ms": {
      "type": "continuous",
      "range": [
        800,
        3000
      ],
      "meaning": "Per-trial deadline; 3000 is effectively none.",
      "direction": "down_is_harder",
      "monotonic": true,
      "research": "research.md#sato"
    },
    "trials": {
      "type": "ordinal",
      "values": [
        30,
        32,
        34,
        36,
        40,
        60,
        80,
        100,
        120,
        140
      ],
      "meaning": "Trials in the block.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#interference"
    },
    "practice_trials": {
      "type": "ordinal",
      "values": [
        8,
        10,
        12
      ],
      "meaning": "Practice trials; never scored.",
      "direction": "nominal",
      "monotonic": false,
      "research": "research.md#interference"
    },
    "n": {
      "type": "ordinal",
      "values": [
        1,
        2,
        3
      ],
      "meaning": "n-back distance; load on updating scales with n.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#nback"
    },
    "lure_rate": {
      "type": "continuous",
      "range": [
        0.05,
        0.25
      ],
      "meaning": "Proportion of n-1 / n+1 lure trials, which require precise tracking.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#nback"
    },
    "stimulus_duration_ms": {
      "type": "continuous",
      "range": [
        300,
        800
      ],
      "meaning": "Exposure of each n-back stimulus.",
      "direction": "down_is_harder",
      "monotonic": true,
      "research": "research.md#nback"
    },
    "series_rule": {
      "type": "enum",
      "values": [
        "add_constant",
        "multiply",
        "alternating_add",
        "increasing_step",
        "fibonacci_like"
      ],
      "meaning": "The rule the number sequence follows: add the same number each time; multiply by the same number; two steps that alternate; a step that grows by the same amount each time; each term is the sum of the two before it.",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#number-series"
    },
    "terms_shown": {
      "type": "ordinal",
      "values": [
        4,
        5,
        6,
        7
      ],
      "meaning": "Numbers shown before the gap (number_series) or in total (odd_number_out). Fewer terms give less evidence for the rule.",
      "direction": "down_is_harder",
      "monotonic": true,
      "research": "research.md#number-series"
    },
    "difficulty_label": {
      "type": "enum",
      "values": [
        "easy",
        "medium",
        "hard"
      ],
      "meaning": "Free-form written questions: the difficulty level the writer is asked for (easy = quick and low-load; hard = more to hold in mind, interference or time pressure).",
      "direction": "up_is_harder",
      "monotonic": true,
      "research": "research.md#freeform"
    }
  },

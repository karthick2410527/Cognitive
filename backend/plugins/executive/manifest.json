  "prompt": {
    "brief": "brief.md",
    "forbidden_patterns": [
      {
        "pattern": "A reasoning item whose rule is stated in words anywhere on screen",
        "why": "Removes the induction, which is the construct."
      },
      {
        "pattern": "An option that is 'none of the above' or 'I don't know'",
        "why": "Changes the response process; keep the set homogeneous."
      },
      {
        "pattern": "A rule requiring cultural or numerical knowledge (calendars, currency, alphabet order in a specific script)",
        "why": "Introduces knowledge as a confound."
      },
      {
        "pattern": "Colour as the rule-bearing attribute without declaring colour_dependent",
        "why": "Accessibility failure."
      },
      {
        "pattern": "Mixing more than two rules on the same attribute",
        "why": "Produces contradictory puzzles that the solver rejects anyway."
      },
      {
        "pattern": "An interference block without a deadline above theta 0.5",
        "why": "Leaves the speed-accuracy trade-off uncontrolled."
      },

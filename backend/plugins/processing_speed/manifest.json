  "prompt": {
    "brief": "brief.md",
    "forbidden_patterns": [
      {
        "pattern": "Hiding or removing the symbol key during the block",
        "why": "Turns the task into paired-associate learning."
      },
      {
        "pattern": "Rule switching, inhibition or ambiguity",
        "why": "Measures executive function, not speed."
      },
      {
        "pattern": "Blocks longer than 120 seconds",
        "why": "Begins to measure sustained attention."
      },
      {
        "pattern": "Prose questions, or multiple-choice items without a short time limit (15 s or less)",
        "why": "Speed is the construct: a written item measures processing speed only under time pressure, and one item carries little information, so many short items are needed."
      },
      {
        "pattern": "Instructions longer than 40 words",
        "why": "Instruction comprehension becomes the measured variable."
      }
    ],
    "referent_classes": [
      "geometric_shapes",
      "abstract_symbols",
      "digits",
      "letter_codes"
    ],
    "thinking": "low",
    "reading_level": "grade_4"
  },
  "context_blind_tolerance_pp": 8,
  "scoring": {
    "primary": "throughput",
    "derived": [
      "median_rt",
      "rt_cv",
      "choice_cost",
      "bucket_rates",
      "within_block_slope",
      "anticipations",
      "lapses"
    ],
    "sato_control": true,
    "report_label": "Processing speed",
    "report_blurb": "How quickly simple operations were carried out when they were easy.",
    "report_caveat": "Sensitive to cognitive change but not specific to any cause. This digital substitution task is not the SDMT and is not comparable with it.",
    "report_components": []
  },
  "mandatory_task_types": [
    "simple_rt_block"
  ],
  "requires_services": [
    "timing_harness",
    "trial_sequencer",
    "glyph_assets"
  ],
  "bank": {
    "k_min_per_cell": 8,
    "k_fresh_per_cell": 3,
    "b_band_width": 0.75,
    "batch_size": 4,
    "locales": [
      "en",
      "en-IN"
    ]
  }
}

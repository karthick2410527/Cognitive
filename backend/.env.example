# Cognimetric v2 — configuration. Precedence: env var > cognimetric.config.json > default.
DATABASE_URL=postgres://localhost:5432/cognimetric
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Generation provider: "local" (procedural authors, no key needed) or "gemini".
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Max Gemini calls per minute from each backend process (0 = no limit). The free tier allows only a
# few; raise it on a paid key. Calls over the limit wait instead of failing with HTTP 429.
GEMINI_RPM=12
DAILY_SPEND_CAP_USD=5
TIER_C_BUDGET_MS=6000

# Secrets: the server refuses to boot in production with the development defaults.
ADMIN_TOKEN=change-me
PROBE_ENCRYPTION_KEY=change-me

# Development only: shortens timed blocks (0.05–1). Ignored when NODE_ENV=production;
# sessions run with it are flagged "not a valid measurement" on the report.
DEV_TIME_SCALE=1

# Bank / workers
SEED_K=6
WORKER_INTERVAL_MS=5000
SCHEDULER_INTERVAL_MS=60000
CALIBRATOR_INTERVAL_MS=3600000
PROBATION_ITEMS=200
